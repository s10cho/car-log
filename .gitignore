# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local toolchain paths
/android/local.properties
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh

# CocoaPods
/ios/Pods/

# 비밀 파일은 ignore하지 않고 git-crypt로 암호화해서 추적한다.
# 대상 패턴은 .gitattributes 에 있다. 거기에 없는 비밀 파일은 커밋하지 말 것.

# git-crypt 키 자체는 저장소에 들어가면 안 된다.
*.key
!ios/**/*.key
