# git-crypt: 아래 경로는 커밋될 때 자동으로 암호화된다.
# 새 비밀 파일을 추가하면 여기에 패턴을 먼저 등록한 뒤 `git add` 할 것.
# 등록 전에 커밋하면 평문이 공개 저장소에 그대로 올라간다.
#
# 상태 확인:  git-crypt status -e
# 잠금 해제:  git-crypt unlock ~/.config/git-crypt/car-log.key

# CI/배포용 자격증명 (Firebase 서비스 계정 등)
secrets/** filter=git-crypt diff=git-crypt
secrets/README.md !filter !diff

# 서명 자료
*.jks filter=git-crypt diff=git-crypt
*.keystore filter=git-crypt diff=git-crypt
*.p8 filter=git-crypt diff=git-crypt
*.p12 filter=git-crypt diff=git-crypt
*.mobileprovision filter=git-crypt diff=git-crypt
android/key.properties filter=git-crypt diff=git-crypt

# Firebase 설정
android/app/google-services.json filter=git-crypt diff=git-crypt
ios/Runner/GoogleService-Info.plist filter=git-crypt diff=git-crypt

# 로컬 환경 변수
.env filter=git-crypt diff=git-crypt
.env.* filter=git-crypt diff=git-crypt

# .gitattributes 자체는 절대 암호화하지 않는다.
.gitattributes !filter !diff
